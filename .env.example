# Agent Correspondent — environment
#
# Every variable is optional. The platform runs with none of them set and
# reports each unconfigured surface as NOT CONNECTED rather than showing a
# placeholder number. Set only what you need.

# --- Core -------------------------------------------------------------------
# Without DATABASE_URL there is no authentication and no stored data.
DATABASE_URL=postgres://user@localhost:5432/agent_correspondent
AUTH_SECRET=
# `production` enables the production-only guards (no testnet, no TESTNET_ONLY
# capabilities, Secure cookies).
ACOR_ENV=development
NEXT_PUBLIC_SITE_URL=https://agentcorrespondent.com

# --- Authentication ---------------------------------------------------------
# AUTH_SECRET must be at least 16 characters; generate one with
# `openssl rand -base64 48`. Without it, authentication reports itself
# unavailable rather than falling back to something weaker.
#
# AUTH_BASE_URL is the origin Better Auth issues callbacks and cookies for.
# Defaults to NEXT_PUBLIC_SITE_URL.
AUTH_BASE_URL=
# Extra origins allowed to complete an OAuth redirect, comma separated. An
# exact allowlist — never a wildcard, because an open redirect in an auth flow
# hands an attacker a valid session.
AUTH_TRUSTED_ORIGINS=
# The WebAuthn relying-party id for passkeys. Defaults to the site hostname.
# Changing it invalidates every enrolled passkey, so set it once.
AUTH_RP_ID=

# Social sign-in. Each provider appears on the sign-in page only when both of
# its variables are set; otherwise it is shown as unavailable rather than as a
# button that fails after the redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Rate limits, per 60-second window per client. Counters are stored in Postgres
# so they hold across instances. These tune the thresholds; limiting cannot be
# switched off. Raise them only where many real clients share one egress IP.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_SIGN_IN=5
AUTH_RATE_LIMIT_SIGN_UP=5
AUTH_RATE_LIMIT_RESET=3

# --- Transactional email ----------------------------------------------------
# Verification links and password resets. Without these the product says mail
# cannot be delivered rather than pretending a link was sent; in production
# that also means no account can be verified, and so none can act economically.
RESEND_API_KEY=
EMAIL_FROM=

# --- Billing ----------------------------------------------------------------
# Price identifiers are generated per Paddle account and are never hard-coded.
# Checkout is offered only when the API key, the webhook secret and the price
# id for the plan are all present.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_BUILDER_MONTHLY=
PADDLE_PRICE_BUILDER_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=

# --- Model providers --------------------------------------------------------
# At least one is required for the chat surface.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Arc --------------------------------------------------------------------
# Mainnet and testnet are separate variables, never the same variable with a
# flag: reusing a testnet address in production is not recoverable.
ARC_NETWORK=mainnet
ARC_CHAIN_ID=5042
ARC_RPC_URL=
ARC_USDC_ADDRESS=
ARC_ERC8004_ADDRESS=
ARC_ERC8183_ADDRESS=
# Required before any intent can be compiled: an authorization must be bound to
# a specific chain and contract.
ARC_INTENT_VERIFIER_ADDRESS=

ARC_TESTNET_RPC_URL=
ARC_TESTNET_USDC_ADDRESS=
ARC_TESTNET_ERC8004_ADDRESS=
ARC_TESTNET_ERC8183_ADDRESS=
ARC_TESTNET_INTENT_VERIFIER_ADDRESS=

# --- Circle -----------------------------------------------------------------
# Server-side only. Never exposed to the browser or to a model context.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_BASE_URL=https://api.circle.com

# --- Identity verification --------------------------------------------------
# Without a provider, live settlement is refused rather than allowed: an
# unverifiable organization is one nobody can attribute a payment to. There is
# deliberately no manual approval path.
KYC_PROVIDER=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_WEBHOOK_SECRET=

# --- Wallet connection ------------------------------------------------------
# WalletConnect / Reown, for connecting a wallet that is not injected into the
# browser. Without it the wallets page offers only an injected wallet and says
# why.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Xaman, for binding an XRPL account from the browser. Without it the XRPL proof
# exchange is available through the API only, and the page says so.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# --- XRPL -------------------------------------------------------------------
XRPL_NETWORK=mainnet
XRPL_WS_URL=
XRPL_RLUSD_ISSUER=
XRPL_SOURCE_TAG=

# --- Optional integrations --------------------------------------------------
# Neither is required for the consumer product, and neither is
# settlement-critical.
KALEIDO_BASE_URL=
KALEIDO_API_KEY=
BLOCKDAG_RPC_URL=

# --- ACOR -------------------------------------------------------------------
# Leave empty until a real deployment has been verified. The /acor page shows
# CONTRACT NOT YET DEPLOYED while this is unset, and must never be hard-coded.
NEXT_PUBLIC_ACOR_CONTRACT_ADDRESS=

# --- Escape hatches ---------------------------------------------------------
# Allows EXPERIMENTAL capabilities (e.g. multilateral netting) to execute.
ACOR_ALLOW_EXPERIMENTAL=0
